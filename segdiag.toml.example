# Example segdiag configuration file.
#
# Copy this to `segdiag.toml` in the directory you run `segdiag` from (or pass
# an explicit path once segdiag.core.config.load_config gains a CLI flag for
# it). Every value here is optional and only fills in a default for a CLI
# flag you didn't pass explicitly - an explicit `--flag` on the command line
# always wins.

[dataset]
raw_name = "Flatten_561"
dark_name = "Flatten_561_dark"
mask_name = "Flatten_561_mask"

[thresholds]
# Not yet wired through to segdiag.core.matching/fp_root_cause (see
# segdiag.core.config's docstring) - reserved for when that lands.
tp_iou = 0.5
blind_fn_iou = 0.05
fp_boundary_split_distance = 20.0

[output]
format = ["csv", "html"]
output_dir = "results/"
